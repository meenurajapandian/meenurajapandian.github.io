---
const links = [
  { href: '/about/', label: 'about' },
  { href: '/projects/', label: 'projects' },
  { href: '/publications/', label: 'publications' },
  { href: '/blog/', label: 'blog' },
];

const current = Astro.url.pathname;
---

<header class="nav-wrap">
  <div class="wrap nav">
    <a href="/" class="nav-name">meenu rajapandian</a>
    <nav>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current.startsWith(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }

  .nav-name {
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  nav a {
    text-decoration: none;
    color: var(--text-muted);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent-text);
  }

  @media (max-width: 600px) {
    .nav {
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }

    nav ul {
      gap: 0.85rem;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const setNavHeight = () => {
    const nav = document.querySelector('.nav-wrap');
    if (nav instanceof HTMLElement) {
      document.documentElement.style.setProperty('--nav-height', `${nav.offsetHeight}px`);
    }
  };

  setNavHeight();
  window.addEventListener('resize', setNavHeight);
</script>
